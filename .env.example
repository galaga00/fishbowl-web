CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
OWNER_ANALYTICS_KEY=change-this-private-owner-key
# Set the same OWNER_ANALYTICS_KEY in the matching Convex deployment.
ANALYTICS_IP_SALT=change-this-private-random-salt

# Development tests only: set both in the development Convex deployment too.
# Never enable the E2E helper or configure its secret in production.
E2E_TEST_SECRET=change-this-development-only-secret
FISH_BOWL_E2E_ENABLED=true

# Optional owner email notifications through Resend
RESEND_API_KEY=your-resend-api-key
OWNER_NOTIFY_EMAIL=you@example.com
OWNER_NOTIFY_FROM=Fish Bowl <onboarding@resend.dev>
ANALYTICS_NOTIFY_EVENTS=game_started

# Optional for scripts/generate-tmdb-cards.mjs
TMDB_READ_ACCESS_TOKEN=your-tmdb-read-access-token
